# ==============================================================================
# CAFE CAMPUS - KONFIGURASI ENVIRONMENT (.env.example)
# Salin file ini menjadi .env lalu sesuaikan nilainya dengan konfigurasi server.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MODE APLIKASI & SERVER UTAMA
# ------------------------------------------------------------------------------
# APP_MODE: Menentukan lingkungan operasional sistem.
# - 'production' (DEFAULT): Keamanan penuh. Simulasi bayar demo dinonaktifkan, 
#   reset data demo dinonaktifkan, verifikasi ketat berlaku, Midtrans nyata.
# - 'demo': Mode showcase/review. Tombol simulasi bayar, reset data demo aktif,
#   dan OTP demo ditampilkan di respons pengujian.
APP_MODE=production

# PORT: Port listen HTTP server Express (Default: 4176)
PORT=4176

# HOST: Alamat interface jaringan bind server (0.0.0.0 untuk semua interface / LAN)
HOST=0.0.0.0

# NODE_ENV: Mode runtime Node.js ('production' atau 'development')
NODE_ENV=production

# APP_URL: URL publik basis sistem (digunakan untuk pembuatan QR Code Meja & callback Midtrans)
# Contoh: http://192.168.1.10:4176 atau https://order.cafecampus.id
APP_URL=http://localhost:4176

# ALLOWED_ORIGINS: Domain CORS yang diizinkan memanggil API (pisahkan koma jika jamak)
# Contoh: https://order.cafecampus.id,https://admin.cafecampus.id
# Kosongkan bila frontend dan backend disajikan dari domain/host yang sama.
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 2. KEAMANAN & AUTENTIKASI (JWT & SESSIONS)
# ------------------------------------------------------------------------------
# JWT_SECRET: Kunci kriptografi penandatanganan token otentikasi admin, kasir, dan dapur.
# WAJIB minimal 32 karakter acak berkualitas kriptografis tinggi. Jangan gunakan nilai default!
# Buat dengan: openssl rand -base64 32 atau npm run gen-secrets
JWT_SECRET=ganti_dengan_kunci_jwt_rahasia_minimal_32_karakter_acak_anda

# Kredensial bootstrap admin untuk database baru / admin seed yang masih demo.
# Wajib diisi pada Railway jika APP_MODE=production dan hash admin masih default.
# Kosongkan untuk APP_MODE=demo; jangan pakai akun demo pada production.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 3. DATABASE MYSQL
# ------------------------------------------------------------------------------
# Opsi A: Koneksi per komponen
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# DB_PASS= (alternatif nama variabel untuk password database jika menggunakan DB_PASS)
DB_NAME=cafe_campus_db
DB_SSL=false

# Opsi B: Connection String URL tunggal (prioritas tertinggi).
# Railway MySQL menyediakan MYSQL_URL; hubungkan sebagai Reference Variable
# pada service aplikasi, misalnya ${{MySQL.MYSQL_URL}}.
MYSQL_URL=
# DATABASE_URL juga didukung, tetapi HARUS berisi URL MySQL/MariaDB, bukan PostgreSQL.
DATABASE_URL=

# Alternatif variabel native Railway MySQL (jika tidak memakai MYSQL_URL):
MYSQLHOST=
MYSQLPORT=3306
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=

# Opsional: batas koneksi dan timeout pool database.
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY MIDTRANS (SNAP & QRIS REALTIME)
# ------------------------------------------------------------------------------
# MIDTRANS_IS_PRODUCTION: 'true' untuk akun Midtrans Production, 'false' untuk Sandbox pengujian
MIDTRANS_IS_PRODUCTION=false

# MIDTRANS_SERVER_KEY: Kunci server Midtrans untuk otorisasi Snap API & verifikasi signature webhook
# Sandbox biasanya berawalan 'SB-Mid-server-...' sedangkan Production 'Mid-server-...'
MIDTRANS_SERVER_KEY=SB-Mid-server-placeholder_server_key

# MIDTRANS_CLIENT_KEY: Kunci klien Midtrans yang dipakai frontend Snap JS SDK
# Sandbox biasanya berawalan 'SB-Mid-client-...' sedangkan Production 'Mid-client-...'
MIDTRANS_CLIENT_KEY=SB-Mid-client-placeholder_client_key

# ------------------------------------------------------------------------------
# 5. WEB PUSH NOTIFICATION (VAPID)
# ------------------------------------------------------------------------------
# Digunakan untuk mengirim notifikasi push browser ke layar kasir & dapur saat ada pesanan masuk.
# Buat pasangan kunci menggunakan npx web-push generate-vapid-keys atau npm run gen-secrets
VAPID_PUBLIC_KEY=placeholder_vapid_public_key
VAPID_PRIVATE_KEY=placeholder_vapid_private_key
VAPID_EMAIL=mailto:admin@cafecampus.demo

# ------------------------------------------------------------------------------
# 6. INTEGRASI GOOGLE GEMINI AI (OCR KTM & BARISTA CHATBOT)
# ------------------------------------------------------------------------------
# GEMINI_KTM_API_KEY: Kunci API Google AI Studio / Gemini untuk pemindaian OCR cerdas KTM mahasiswa secara real-time.
GEMINI_KTM_API_KEY=placeholder_gemini_ktm_api_key

# GEMINI_CHATBOT_API_KEY: Kunci API Google Gemini untuk kecerdasan percakapan Barista AI Chatbot.
GEMINI_CHATBOT_API_KEY=placeholder_gemini_chatbot_api_key

# ------------------------------------------------------------------------------
# 7. BATASAN BISNIS & OPERASIONAL CAFE
# ------------------------------------------------------------------------------
# STUDENT_DAILY_LIMIT: Batas maksimal pesanan harga diskon mahasiswa per NIM per hari kalender
# Mengurangi risiko Sybil attack / jastip berulang dengan satu kartu mahasiswa.
STUDENT_DAILY_LIMIT=1

# QRIS_EXPIRY_MINUTES: Masa berlaku tagihan QRIS dalam satuan menit sebelum otomatis kedaluwarsa.
# Setelah menit ini terlewati, pesanan QRIS yang belum dibayar akan otomatis dibatalkan/dilepas.
QRIS_EXPIRY_MINUTES=15

# ------------------------------------------------------------------------------
# 8. IDENTITAS CAFE & OPERASIONAL (SEED DEFAULT PENGATURAN)
# ------------------------------------------------------------------------------
CAFE_NAME=Cafe Campus
CAFE_ADDRESS=Kawasan Kampus Terpadu, Jl. Mahasiswa No. 8
CAFE_PHONE=0812-3456-7890
OPERATING_HOURS=Senin - Minggu: 08.00 - 23.00 WIB
WIFI_SSID=CafeCampus_HighSpeed
WIFI_PASS=kopikampus2026

# Kredensial Administrator Awal (Hanya untuk inisialisasi awal/demo)
